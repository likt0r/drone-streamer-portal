[Unit]
Description=Drone Streamer FastAPI Hardware Stats backend
After=network.target

[Service]
User=pi
WorkingDirectory=/home/pi/drone-streamer-portal/backend
Environment="PATH=/home/pi/drone-streamer-portal/backend/venv/bin"
ExecStart=/home/pi/drone-streamer-portal/backend/venv/bin/uvicorn main:app --host 0.0.0.0 --port 5002

Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
