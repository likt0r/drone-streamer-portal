[Unit]
Description=Drone Streamer FastAPI backend (stream settings + hardware stats)
After=network.target

[Service]
User=root
WorkingDirectory=/opt/drone-streamer-backend
Environment="PATH=/opt/drone-streamer-backend/venv/bin"
ExecStart=/opt/drone-streamer-backend/venv/bin/uvicorn main:app --host 0.0.0.0 --port 5002
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
