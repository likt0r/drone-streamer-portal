[Unit]
# Dev frontend: the Vite dev server (HMR). nginx (dev-pi.conf) reverse-proxies
# "/" to 127.0.0.1:5173. Installed/started by scripts/dev-mode.sh, which fills in
# __NODE_DIR__ (the directory of the active `node`/`npm`, e.g. Zed's bundled Node)
# and __REPO_DIR__ at install time so it survives Node version changes.
Description=Drone Streamer DEV frontend (Vite dev server)
After=network-online.target

[Service]
User=pi
WorkingDirectory=__REPO_DIR__
Environment=PATH=__NODE_DIR__:/usr/local/bin:/usr/bin:/bin
Environment=PI_DEV=1
ExecStart=__NODE_DIR__/npm run dev
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
