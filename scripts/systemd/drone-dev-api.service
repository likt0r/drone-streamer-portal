[Unit]
# Dev backend: uvicorn with --reload, running from the REPO source so edits to
# backend/main.py hot-reload. Mutually exclusive with drone-stats (both bind :5002).
# Installed/started by scripts/dev-mode.sh. __REPO_DIR__ is filled in at install time.
Description=Drone Streamer DEV backend (uvicorn --reload)
After=network-online.target
Wants=network-online.target

[Service]
User=root
WorkingDirectory=__REPO_DIR__/backend
ExecStart=/opt/drone-streamer-backend/venv/bin/uvicorn main:app --host 0.0.0.0 --port 5002 --reload --reload-dir __REPO_DIR__/backend
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
